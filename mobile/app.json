{
  "expo": {
    "name": "CareRelay",
    "slug": "carerelay",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "carerelay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "au.vaultwest.carerelay",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "au.vaultwest.carerelay"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-sharing",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
